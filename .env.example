# Banco PostgreSQL descartável já migrado para o teste de concorrência de certificados.
CERTIFICATE_CONCURRENCY_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_URL=http://localhost:3000
AUTH_PUBLIC_SIGNUP_ENABLED=false
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
NEXT_ALLOWED_DEV_ORIGINS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=PROTEA-R <noreply@example.com>
ABACATE_PAY_API_KEY=
ABACATEPAY_API_KEY=
