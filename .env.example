DATABASE_URL=
DATABASE_URL_DIRECT=
STAGING_DATABASE_HOST=
STAGING_NEON_BRANCH_ID=
STAGING_OPERATION_CONFIRMATION=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
# Host direto da branch Neon Development. O preflight compara as duas URLs
# sem imprimir credenciais.
DEVELOPMENT_DATABASE_HOST=
# Confirmação exigida pelo seed remoto compartilhado.
SHARED_DEVELOPMENT_SEED_CONFIRMATION=
DEVELOPMENT_ADMIN_EMAIL=
DEVELOPMENT_ADMIN_PASSWORD=
DEVELOPMENT_STUDENT_EMAIL=
DEVELOPMENT_STUDENT_PASSWORD=
E2E_TEST_MODE=false
# Banco descartável já migrado; usado exclusivamente por Playwright.
E2E_DATABASE_URL=
# Confirmação obrigatória do bucket privado isolado de E2E. Deve ser exatamente igual a R2_BUCKET_NAME.
E2E_R2_BUCKET_NAME=
# Lista separada por vírgula. Obrigatória para db:reset:local; use apenas bancos descartáveis locais.
LOCAL_DATABASE_NAMES=hub_test
SMOKE_DATABASE_URL=
# Banco PostgreSQL descartável já migrado para o teste de concorrência de certificados.
CERTIFICATE_CONCURRENCY_DATABASE_URL=
# Segredo proprio com pelo menos 32 caracteres em producao.
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
# Em producao, esta URL, NEXT_PUBLIC_APP_URL e CERTIFICATE_PUBLIC_BASE_URL
# devem usar HTTPS e a mesma origem.
BETTER_AUTH_URL=http://localhost:3000
AUTH_PUBLIC_SIGNUP_ENABLED=false
APPLICATION_MAINTENANCE_MODE=off
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
NEXT_ALLOWED_DEV_ORIGINS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Definidas automaticamente pela Vercel. Nao preencher em Development.
VERCEL_ENV=
VERCEL_TARGET_ENV=
# Espelho público gerenciado pela Vercel para classificação Sentry no navegador.
# Nunca definir manualmente em Development.
NEXT_PUBLIC_VERCEL_TARGET_ENV=
VERCEL_BRANCH_URL=
VERCEL_URL=
RESEND_API_KEY=
# Allowlist separada por vírgula. Obrigatória quando Development envia e-mail.
DEVELOPMENT_EMAIL_RECIPIENT_ALLOWLIST=
# Remetente verificado no Resend. Nao precisa ser uma caixa de entrada.
RESEND_FROM_EMAIL=Neuro Capacitar <notificacoes@neurocapacitar.com.br>
# Development local somente. Preview proibe credenciais de provider.
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
# Identificador estavel exigido pelo Asaas; inclua produto e contato tecnico.
ASAAS_USER_AGENT=hub/1.0 pagamentos@example.com
# Segredo exclusivo do webhook Asaas, com pelo menos 32 caracteres.
ASAAS_WEBHOOK_TOKEN=
# Kill switch exclusivo da entrada e do worker Asaas.
ASAAS_WEBHOOK_ENABLED=true
# disabled bloqueia tudo; authenticated bloqueia somente a rota pública; public libera ambas.
PAYMENTS_CHECKOUT_MODE=public
INTERNAL_BOOTSTRAP_SECRET=
# Caixa real e monitorada. Tambem e o Reply-To padrao dos e-mails automaticos.
SUPPORT_EMAIL=suporte@neurocapacitar.com.br
CERTIFICATE_PUBLIC_BASE_URL=http://localhost:3000
# `x-forwarded-for` para Vercel. Use `cloudflare` somente se
# a origem aceitar trafego exclusivamente do proxy Cloudflare.
CLIENT_IP_SOURCE=x-forwarded-for
CRON_SECRET=
# Kill switch dos Vercel Crons. Use true somente em Production; mantenha false
# em Preview para impedir jobs contra provedores e dados definitivos.
SCHEDULED_JOBS_ENABLED=false
# Bearer exigido por GET /api/health/ready em producao. Nao reutilize CRON_SECRET.
HEALTHCHECK_SECRET=
# Evidência somente leitura de ensaio operacional; não representa execução do restore.
RECOVERY_DRILL_OWNER=
RECOVERY_DRILL_ENVIRONMENT=staging
RECOVERY_DRILL_MIGRATION_JOURNAL=
RECOVERY_DRILL_READINESS=
RECOVERY_DRILL_MIGRATION=
RECOVERY_DRILL_ALERTS=
SENTRY_DSN=
# Mesmo DSN publico para captura de falhas do navegador; nao inclua dados pessoais no evento.
NEXT_PUBLIC_SENTRY_DSN=
STAGING_SENTRY_PROJECT_ID=
# ID numérico do projeto Sentry hub-development.
DEVELOPMENT_SENTRY_PROJECT_ID=
# Usado apenas no build para publicar source maps no projeto Sentry; nunca exibir ao navegador.
SENTRY_AUTH_TOKEN=
JMVSTREAM_API_BASE_URL=https://api.jmvstream.com
# Optional fallback JWT. Prefer the auth credentials below so the app can renew expired tokens.
JMVSTREAM_API_TOKEN=
JMVSTREAM_PLAN_ID=
# Deve repetir o Plan ID Development para impedir troca silenciosa de recurso.
DEVELOPMENT_JMVSTREAM_PLAN_ID=
# Excecao explicita: true permite usar o plano Production no desenvolvimento local.
# Nesse modo, DEVELOPMENT_JMVSTREAM_PLAN_ID pode ficar vazio.
DEVELOPMENT_JMVSTREAM_USES_PRODUCTION=false
STAGING_JMVSTREAM_USES_PRODUCTION=false
# UUID do recurso/aplicacao JMVStream usado no POST /v2/authenticate. Nao use JWT/Bearer token aqui.
JMVSTREAM_AUTH_RESOURCE=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.example.com
R2_OBJECT_PREFIX=
STAGING_R2_USES_DEVELOPMENT=false
STAGING_RESEND_USES_PRODUCTION=false
