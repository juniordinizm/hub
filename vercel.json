{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"${VERCEL_GIT_COMMIT_REF:-}\" = \"main\" ] || [ \"${VERCEL_GIT_COMMIT_REF:-}\" = \"staging\" ]; then exit 1; fi; exit 0",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/asaas-webhooks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/enrollments",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/jmvstream",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/outbox",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/resend-webhooks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 4 * * *"
    }
  ]
}
